<?xml version="1.0" encoding="utf-8"?><Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="VAE_SiegebreakerArmor"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/ResearchProjectDef[defName="VAE_SiegebreakerArmor"]</xpath>
      <value>
        <li Class="LifeLessons.ResearchProficiencyExtension">
          <requirements>
            <li>Engineering</li>
          </requirements>
          <hardRequirement>True</hardRequirement>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="VAE_TrooperArmor"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/ResearchProjectDef[defName="VAE_TrooperArmor"]</xpath>
      <value>
        <li Class="LifeLessons.ResearchProficiencyExtension">
          <requirements>
            <li>Engineering</li>
          </requirements>
          <hardRequirement>True</hardRequirement>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="VAE_HazardProtection"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/ResearchProjectDef[defName="VAE_HazardProtection"]</xpath>
      <value>
        <li Class="LifeLessons.ResearchProficiencyExtension">
          <requirements>
            <li>Chemistry</li>
          </requirements>
          <hardRequirement>True</hardRequirement>
        </li>
      </value>
    </match>
  </Operation>
</Patch>