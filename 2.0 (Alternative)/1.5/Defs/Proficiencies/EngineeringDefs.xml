  <LifeLessons.ProficiencyDef ParentName="ProficiencyBase">
    <defName>Engineering</defName>
    <label>Engineering</label>
    <proficiencyAdjective>intricate mechanical</proficiencyAdjective>
    <generationRules>
      <textbookValue>1950</textbookValue>
      <neurotrainerValue>14500</neurotrainerValue>
      <bookTradeTags>
        <li>LLTextbooksRare</li>
      </bookTradeTags>
      <neurotrainerTradeTags>
        <li>LLNeurotrainerRare</li>
      </neurotrainerTradeTags>
    </generationRules>
    <category>ProficiencyCategory_Construction</category>
    <description>The ability to design and implement complex systems using electrical or mechanical components.</description>
    <costPractical>2000</costPractical>
    <costTheoretical>3200</costTheoretical>
    <canBePioneered>true</canBePioneered>
    <effectiveSubjectLimit>1</effectiveSubjectLimit>
    <learningEffectivenessLossPerSubject>0.3</learningEffectivenessLossPerSubject>
